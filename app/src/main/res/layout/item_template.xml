<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_template_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- 方形预览区域 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/iv_template_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="模板预览"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tv_template_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🎨"
            android:textSize="32sp" />
    </FrameLayout>

    <!-- 模板名称 -->
    <TextView
        android:id="@+id/tv_template_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/kid_dark_text"
        android:textSize="13sp" />

</LinearLayout>
