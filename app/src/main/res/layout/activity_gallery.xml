<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kid_pink"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/kid_pink"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="返回"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/gallery_title"
            android:textColor="@color/kid_white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 导入照片按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/kid_cream"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/btn_import_photo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/btn_kid_secondary"
            android:minWidth="200dp"
            android:paddingHorizontal="24dp"
            android:text="@string/gallery_import_photo"
            android:textColor="@color/kid_dark_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 素材网格 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_templates"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/kid_cream"
        android:clipToPadding="false"
        android:padding="12dp" />

</LinearLayout>
