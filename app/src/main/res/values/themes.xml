<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 12+ SplashScreen API 主题 -->
    <style name="Theme.Drawing.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kid_pink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/kid_white</item>
        <item name="postSplashScreenTheme">@style/Theme.Drawing</item>
    </style>

    <!-- Base application theme - Kid friendly -->
    <style name="Theme.Drawing" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/kid_pink</item>
        <item name="colorPrimaryVariant">@color/kid_pink_dark</item>
        <item name="colorOnPrimary">@color/kid_white</item>

        <item name="colorSecondary">@color/kid_blue</item>
        <item name="colorSecondaryVariant">@color/kid_blue_light</item>
        <item name="colorOnSecondary">@color/kid_white</item>

        <item name="android:colorBackground">@color/kid_cream</item>
        <item name="colorSurface">@color/kid_white</item>
        <item name="colorOnSurface">@color/kid_dark_text</item>

        <item name="android:statusBarColor">@color/kid_pink</item>
        <item name="android:navigationBarColor">@color/kid_white</item>

        <item name="shapeAppearanceSmallComponent">@style/KidShapeSmall</item>
        <item name="shapeAppearanceMediumComponent">@style/KidShapeMedium</item>
        <item name="shapeAppearanceLargeComponent">@style/KidShapeLarge</item>
    </style>

    <style name="KidShapeSmall" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="KidShapeMedium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="KidShapeLarge" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

</resources>
