<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 仅 Android 9 写入外部存储需要此权限；Android 10+ 通过 MediaStore 写入无需权限 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Drawing">

        <!-- Launcher: 使用 Android 12+ SplashScreen API -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Drawing.SplashScreen"
            android:screenOrientation="fullSensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Template Gallery -->
        <activity
            android:name=".gallery.GalleryActivity"
            android:exported="false"
            android:screenOrientation="fullSensor" />

        <!-- Drawing Screen -->
        <activity
            android:name=".drawing.DrawingActivity"
            android:exported="false"
            android:screenOrientation="fullSensor" />

        <!-- LineArt Processing Screen -->
        <activity
            android:name=".lineart.LineArtActivity"
            android:exported="false"
            android:screenOrientation="fullSensor" />

        <!-- FileProvider for camera photos -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
